# Grace — environment template. cp .env.example .env, then fill in what you have.
# Full detail on what each unlocks: Docs/plans/10-access-and-credentials.md
#
# .env is gitignored — never commit it. Loaded automatically by the Makefile.
# Format: KEY=value, no spaces, no `export`. A value here OVERRIDES the same
# variable in your shell (including blank), so unset vars stay commented out.
# Nothing here is read at run time — every value is baked in at deploy time.

# ── Deploy credentials (required) ──
VAPI_API_KEY=vapi_private_key_goes_here
N8N_API_URL=https://palmleafmassage.app.n8n.cloud
N8N_API_KEY=n8n_api_key_goes_here

# ── Web-call harness — browser-safe PUBLIC key, not the private one above ──
# Vapi dashboard → API Keys → Public Key. Required by `make vapi-harness`.
# VAPI_PUBLIC_KEY=

# ── Vapi tool endpoints (required for a working call) ──
GRACE_TOOLS_URL=https://placeholder.invalid/vapi/tools
GRACE_EVENTS_URL=https://placeholder.invalid/webhooks/vapi/events
# VAPI_TOOLS_CREDENTIAL_ID=

# ── Report email — blocks WF-26 + its 4 callers until set ──
# GRACE_REPORTS_EMAIL_TO=

# ── Customer messaging (make messenger) ─────────────────────────────────────
# Read ONLY by grace_workers.messenger, never by the tool server (invariant I1).
# With these unset the worker still runs: it logs what it would send and leaves the
# message QUEUED, so nobody is ever told "I've texted you" when nothing went out.
#
# SMS — Twilio. Console → Account Info. FROM must be a number you own, E.164.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
#
# Email — any SMTP server (Gmail needs an App Password, not your login password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# GRACE_EMAIL_SUBJECT=PalmLeaf Massage & Wellness
#
# Links sent inside those messages. Until each is set, the matching tool declines to
# promise a send rather than delivering a broken URL to a customer.
# GRACE_INTAKE_FORM_URL=
# GRACE_DEPOSIT_BASE_URL=

# ── Database — local dev Postgres (make db-up). Not a secret; local only. ──
# Port 5434 deliberately: 5432 is taken by this machine's native Postgres.
GRACE_DATABASE_URL=postgresql://grace:grace-dev@localhost:5434/grace

# ── RingCentral — required by `make rc-snapshot` (read-only) ──
# Private JWT app in the RingCentral developer console; production platform.
GRACE_RINGCENTRAL_CLIENT_ID=rc_app_client_id_goes_here
GRACE_RINGCENTRAL_CLIENT_SECRET=rc_app_client_secret_goes_here
GRACE_RINGCENTRAL_JWT=eyJraWQiOiJ_rc_private_jwt_goes_here
# Pilot whitelist — E.164, comma-separated. Phase 2 only; forwards nobody else.
# GRACE_PILOT_CALLERS=

# ── Vagaro — arrives with the API activation email (7 business days) ──
# Everything else in the integration is already built and tested; these unlock it.
# GRACE_VAGARO_CLIENT_ID=
# GRACE_VAGARO_CLIENT_SECRET=
# Only set these if the activation email names different values.
# GRACE_VAGARO_BASE_URL=https://api.vagaro.com
# GRACE_VAGARO_TOKEN_PATH=/api/v2/oauth/token

# ── Staff notifications (the notify worker) ──
# WF-12's webhook URL and the n8n-inbound header value. The worker refuses to start
# without both — an escalation nobody receives is worse than a worker that won't run.
# GRACE_N8N_ESCALATION_URL=
# GRACE_N8N_INBOUND_TOKEN=

# ── Telephony — blocked on GATE-11 ──
# Where an upset caller is transferred. MUST be a line a person answers.
# ⚠️ When RingCentral forwarding to Grace is enabled, this must NOT be the main line
#    847-961-4800 — the call would forward straight back to Grace and loop.
# GRACE_TRANSFER_NUMBER=
# GRACE_MAIN_LINE_NUMBER=
# GRACE_FRONT_DESK_NUMBER=
# GRACE_SIP_TRUNK_CREDENTIAL_ID=

# ── Core API — not built yet, safe to leave unset ──
# GRACE_CORE_API_URL=
# GRACE_INTERNAL_API_TOKEN=
# GRACE_TOOL_DEADLINE_MS=

# ── WF-17 fan-out consumers — ships disabled until named ──
# GRACE_CRM_WEBHOOK_URL=
# GRACE_MARKETING_WEBHOOK_URL=

# ── Local dev only — mock server (make vapi-mock) ──
# GRACE_MOCK_PORT=
# GRACE_MOCK_FAIL=
# GRACE_MOCK_LATENCY_MS=
# GRACE_MOCK_TIMEOUT=
# GRACE_MOCK_NOW=
