{
  "name": "palmleaf-grace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "platform:vapi:generate": "tsx platform/vapi/generate-tools.ts",
    "platform:vapi:prompt": "tsx platform/vapi/build-prompt.ts",
    "platform:vapi:build": "pnpm platform:vapi:generate && pnpm platform:vapi:prompt",
    "platform:vapi:check": "tsx platform/vapi/generate-tools.ts --check && tsx platform/vapi/build-prompt.ts --check && tsx platform/vapi/validate.ts",
    "platform:vapi:validate": "tsx platform/vapi/validate.ts",
    "platform:vapi:diff": "tsx platform/vapi/deploy.ts --diff",
    "platform:vapi:deploy": "tsx platform/vapi/deploy.ts",
    "platform:vapi:mock": "tsx platform/vapi/mock-server/server.ts",
    "platform:n8n:diff": "tsx platform/n8n/deploy.ts --diff",
    "platform:n8n:deploy": "tsx platform/n8n/deploy.ts",
    "platform:n8n:lint": "tsx platform/n8n/lint.ts",
    "platform:vapi:harness": "tsx platform/vapi/web-harness/serve.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^26.1.2",
    "eslint": "^9.9.0",
    "eslint-plugin-import-x": "^4.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
