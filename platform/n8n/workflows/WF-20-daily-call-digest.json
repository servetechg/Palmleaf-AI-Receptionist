{
  "name": "WF-20 Daily Call Digest",
  "nodes": [
    {
      "id": "start",
      "name": "Called by WF-25",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "shape",
      "name": "Shape the request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// The only lines that differ between reports: the fetch window and page size.\n// The fetch itself lives in WF-24, written once and shared.\nreturn [{ json: {\n  sinceIso: $now.minus({ days: 1 }).startOf('day').toISO(),\n  untilIso: $now.startOf('day').toISO(),\n  limit: '1000',\n} }];"
      }
    },
    {
      "id": "fetch",
      "name": "Fetch via WF-24",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "workflowId": "__WF__:wf-24",
        "options": {}
      }
    },
    {
      "id": "analyse",
      "name": "Summarise the day",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// Aggregate a day of normalised calls (fetched via WF-24) into one row.\n// A quiet day still produces a zero row \u2014 a missing report is ambiguous, a zero row is not.\nconst calls = ($input.first().json || {}).calls || [];\nconst total = calls.length;\nconst booked = calls.filter(c => c.booked).length;\nconst escalated = calls.filter(c => c.escalated).length;\nconst medicalHolds = calls.filter(c => c.medicalHold).length;\nconst durations = calls.map(c => c.durationSeconds).filter(s => s > 0);\nconst avg = durations.length\n  ? Math.round(durations.reduce((a, b) => a + b, 0) / durations.length) : 0;\n\n// Containment = handled without a human. The headline number for an AI receptionist.\nconst containment = total ? Math.round(((total - escalated) / total) * 100) : 0;\n\nconst d = new Date(); d.setDate(d.getDate() - 1);\n\nreturn [{ json: {\n  day: d.toISOString().slice(0, 10),\n  total_calls: total,\n  booked,\n  escalated,\n  medical_holds: medicalHolds,\n  avg_duration_seconds: avg,\n  containment_pct: containment,\n} }];"
      }
    },
    {
      "id": "store",
      "name": "Save digest",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        880,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "call_metrics"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "day": "={{ $json.day }}",
            "total_calls": "={{ $json.total_calls }}",
            "booked": "={{ $json.booked }}",
            "escalated": "={{ $json.escalated }}",
            "medical_holds": "={{ $json.medical_holds }}",
            "avg_duration_seconds": "={{ $json.avg_duration_seconds }}",
            "containment_pct": "={{ $json.containment_pct }}"
          },
          "schema": [
            {
              "id": "day",
              "displayName": "day",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "total_calls",
