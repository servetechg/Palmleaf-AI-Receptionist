      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "// Shape the email sent via WF-26 — one line per figure already computed above.\nreturn [{ json: {\n  subject: `PalmLeaf daily call digest — ${$json.day}`,\n  body: `Total calls: ${$json.total_calls}\\nBooked: ${$json.booked}\\nEscalated: ${$json.escalated}\\nMedical holds: ${$json.medical_holds}\\nAverage duration: ${$json.avg_duration_seconds}s\\nContainment: ${$json.containment_pct}%`,\n} }];"
      }
    },
