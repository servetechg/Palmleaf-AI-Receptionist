              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        }
      }
    },
    {
      "id": "shape-email",
      "name": "Shape the email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "// Aggregate every flagged call (Save flags ran once per row) into one email.\n// Zero items in means a clean hour — WF-22 already returns nothing for that; don't email either.\nconst items = $input.all().map(i => i.json);\nif (!items.length) return [];\nconst lines = items.map(c => `- ${c.call_id}: ${c.reasons} (${c.duration_seconds}s) ${c.recording_url}`);\nreturn [{ json: {\n  subject: `PalmLeaf call quality alert — ${items.length} call(s) flagged`,\n  body: lines.join('\\n'),\n} }];"
      }
    },
