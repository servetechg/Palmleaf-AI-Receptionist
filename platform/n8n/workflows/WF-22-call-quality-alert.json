{
  "name": "WF-22 Call Quality Alert",
  "nodes": [
    {
      "id": "start",
      "name": "Called by WF-25",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "shape",
      "name": "Shape the request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// The only lines that differ between reports: the fetch window and page size.\n// The fetch itself lives in WF-24, written once and shared.\nreturn [{ json: {\n  sinceIso: $now.minus({ hours: 1 }).toISO(),\n  untilIso: $now.toISO(),\n  limit: '200',\n} }];"
      }
    },
    {
      "id": "fetch",
      "name": "Fetch via WF-24",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "workflowId": "__WF__:wf-24",
        "options": {}
      }
    },
    {
      "id": "flag",
      "name": "Flag problem calls",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// Flag calls worth a human look. Three signals, each meaning something different:\n//   error        \u2014 the call broke; a caller heard something wrong\n//   very short   \u2014 under 15s usually means Grace failed to engage at all\n//   escalated    \u2014 she handed off; fine occasionally, a pattern if frequent\nconst calls = ($input.first().json || {}).calls || [];\n\nconst flagged = [];\nfor (const c of calls) {\n  const reasons = [];\n\n  if (/error|failed|pipeline/i.test(c.endedReason)) reasons.push('ended in error: ' + c.endedReason);\n  if (c.durationSeconds > 0 && c.durationSeconds < 15) reasons.push('under 15 seconds');\n  if (c.escalated) reasons.push('escalated to a person');\n\n  if (reasons.length) {\n    flagged.push({ json: {\n      detected_at: new Date().toISOString(),\n      call_id: c.id,\n      reasons: reasons.join('; '),\n      duration_seconds: Math.round(c.durationSeconds),\n      recording_url: c.recordingUrl,\n    } });\n  }\n}\n\n// No output when nothing is wrong \u2014 an empty run is the good outcome.\nreturn flagged;"
      }
    },
    {
      "id": "store",
      "name": "Save flags",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        880,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "call_flags"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "detected_at": "={{ $json.detected_at }}",
            "call_id": "={{ $json.call_id }}",
            "reasons": "={{ $json.reasons }}",
            "duration_seconds": "={{ $json.duration_seconds }}",
            "recording_url": "={{ $json.recording_url }}"
          },
          "schema": [
            {
              "id": "detected_at",
              "displayName": "detected_at",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "call_id",
              "displayName": "call_id",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
