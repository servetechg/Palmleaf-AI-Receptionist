{
  "name": "WF-22 Call Quality Alert",
  "nodes": [
    {
      "id": "cron",
      "name": "Hourly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1,
              "triggerAtMinute": 7
            }
          ]
        }
      }
    },
    {
      "id": "fetch",
      "name": "Fetch recent calls",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.vapi.ai/call",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "200"
            },
            {
              "name": "createdAtGe",
              "value": "={{ $now.minus(1, 'hour').toISO() }}"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "__CRED__:vapi",
          "name": "__CRED__:vapi"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "flag",
      "name": "Flag problem calls",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// Flag calls worth a human look. Three signals, each meaning something different:\n//   error        \u2014 the call broke; a caller heard something wrong\n//   very short   \u2014 under 15s usually means Grace failed to engage at all\n//   escalated    \u2014 she handed off; fine occasionally, a pattern if frequent\nconst calls = $input.all().map(i => i.json).flat().filter(c => c && c.id);\n\nconst flagged = [];\nfor (const c of calls) {\n  const o = (c.analysis && c.analysis.structuredData) || {};\n  const dur = c.startedAt && c.endedAt\n    ? (new Date(c.endedAt) - new Date(c.startedAt)) / 1000 : 0;\n  const reasons = [];\n\n  const ended = String(c.endedReason || '');\n  if (/error|failed|pipeline/i.test(ended)) reasons.push('ended in error: ' + ended);\n  if (dur > 0 && dur < 15) reasons.push('under 15 seconds');\n  if (o.escalated === true) reasons.push('escalated to a person');\n\n  if (reasons.length) {\n    flagged.push({ json: {\n      detected_at: new Date().toISOString(),\n      call_id: c.id,\n      reasons: reasons.join('; '),\n      duration_seconds: Math.round(dur),\n      recording_url: (c.artifact && c.artifact.recordingUrl) || '',\n    } });\n  }\n}\n\n// No output when nothing is wrong \u2014 an empty run is the good outcome.\nreturn flagged;"
      }
    },
    {
      "id": "store",
      "name": "Save flags",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        660,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "call_flags"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "detected_at": "={{ $json.detected_at }}",
            "call_id": "={{ $json.call_id }}",
            "reasons": "={{ $json.reasons }}",
            "duration_seconds": "={{ $json.duration_seconds }}",
            "recording_url": "={{ $json.recording_url }}"
          },
          "schema": [
            {
              "id": "detected_at",
              "displayName": "detected_at",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "call_id",
              "displayName": "call_id",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "reasons",
              "displayName": "reasons",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "duration_seconds",
              "displayName": "duration_seconds",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "recording_url",
              "displayName": "recording_url",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        }
      }
    },
    {
      "id": "pg",
      "name": "Archive to Postgres",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        880,
