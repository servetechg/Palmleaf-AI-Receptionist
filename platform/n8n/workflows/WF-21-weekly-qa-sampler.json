        1100,
        0
      ],
      "parameters": {
        "jsCode": "// Aggregate every sampled call (Save sample ran once per row) into one email.\nconst items = $input.all().map(i => i.json);\nconst lines = items.map(c => `- ${c.call_id} (${c.duration_seconds}s, intent: ${c.intent}) ${c.recording_url}`);\nreturn [{ json: {\n  subject: `PalmLeaf weekly QA sample — ${items[0] ? items[0].sampled_week : ''}`,\n  body: `${items.length} calls sampled for review:\\n\\n${lines.join('\\n')}`,\n} }];"
      }
    },
