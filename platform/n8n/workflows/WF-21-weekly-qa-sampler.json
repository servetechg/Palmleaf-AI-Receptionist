            "call_id": "={{ $json.call_id }}",
            "started_at": "={{ $json.started_at }}",
            "duration_seconds": "={{ $json.duration_seconds }}",
            "intent": "={{ $json.intent }}",
            "booked": "={{ $json.booked }}",
            "escalated": "={{ $json.escalated }}",
            "recording_url": "={{ $json.recording_url }}",
            "reviewed": "={{ $json.reviewed }}"
          },
          "schema": [
            {
