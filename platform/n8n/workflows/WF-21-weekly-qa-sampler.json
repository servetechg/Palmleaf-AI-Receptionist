    {
      "id": "shape",
      "name": "Shape the request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// The only lines that differ between reports: the fetch window and page size.\n// The fetch itself lives in WF-24, written once and shared.\nreturn [{ json: {\n  sinceIso: $now.minus({ days: 7 }).startOf('day').toISO(),\n  untilIso: $now.toISO(),\n  limit: '1000',\n} }];"
      }
    },
    {
      "id": "fetch",
      "name": "Fetch via WF-24",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "workflowId": "__WF__:wf-24",
        "options": {}
      }
    },
    {
      "id": "sample",
      "name": "Pick 20 at random",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// Pick 20 calls at random for a human to listen to. Random, not \"worst first\" \u2014\n// sampling the ordinary calls is what catches slow drift in how Grace behaves.\nconst calls = (($input.first().json || {}).calls || []).slice();\n\nfor (let i = calls.length - 1; i > 0; i--) {\n  const j = Math.floor(Math.random() * (i + 1));\n  [calls[i], calls[j]] = [calls[j], calls[i]];\n}\n\nconst week = new Date().toISOString().slice(0, 10);\nreturn calls.slice(0, 20).map(c => ({ json: {\n  sampled_week: week,\n  call_id: c.id,\n  started_at: c.startedAt,\n  duration_seconds: Math.round(c.durationSeconds),\n  intent: c.intent,\n  booked: String(c.booked),\n  escalated: String(c.escalated),\n  recording_url: c.recordingUrl,\n  reviewed: 'no',\n} }));"
      }
    },
    {
      "id": "store",
      "name": "Save sample",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
