{
  "name": "WF-00 Global Error Handler",
  "nodes": [
    {
      "id": "err-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "format",
      "name": "Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Never echo the failing payload: it may contain caller utterances, and this\n// message is forwarded to staff (I6). Identify the workflow and the node, nothing more.\nconst e = $input.first().json;\nconst wf = e.workflow || {};\nconst ex = e.execution || {};\nreturn [{ json: {\n  text: [\n    'n8n workflow failed',\n    'Workflow: ' + (wf.name || 'unknown'),\n    'Node: ' + (ex.lastNodeExecuted || 'unknown'),\n    'Error: ' + String(ex.error?.message || 'unknown').slice(0, 300),\n    'Execution: ' + (ex.id || 'n/a')\n  ].join('\\n')\n} }];"
      }
    },
    {
      "id": "notify",
      "name": "Notify ops",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GRACE_CORE_API_URL }}/internal/notify/ops",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: 'ops', severity: 'error', text: $json.text }) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "__CRED__:core-api",
          "name": "__CRED__:core-api"
        }
      }
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Format",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format": {
      "main": [
        [
          {
            "node": "Notify ops",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}
