{
  "name": "WF-12 Escalation & Alerting",
  "nodes": [
    {
      "id": "hook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "grace-escalation",
      "parameters": {
        "httpMethod": "POST",
        "path": "{{ENV}}/escalation",
        "responseMode": "responseNode",
        "authentication": "headerAuth",
        "options": {
          "rawBody": true
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "__CRED__:n8n-inbound",
          "name": "__CRED__:n8n-inbound"
        }
      }
    },
    {
      "id": "ack",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}"
      }
    },
    {
      "id": "parse",
      "name": "Parse event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// Native Header Auth replaced the HMAC-in-a-Code-node check (Q-04.5): n8n verifies\n// the credential before the workflow even starts, so this node only parses the body.\n// Raw Body stays on (lint rule 14), so parse the bytes; fall back to a pre-parsed body.\nconst raw = $input.first().json.rawBody?.toString('utf8') ?? '';\nlet body = {};\ntry { body = JSON.parse(raw); } catch { body = $input.first().json.body || {}; }\nreturn [{ json: {\n  taskId: body.taskId,\n  type: body.type,\n  priority: Number(body.priority ?? 3),\n  tenant: body.tenant,\n  title: body.title ?? 'Staff task',\n  summary: body.summary ?? '',\n  occurredAt: body.occurredAt,\n} }];"
      }
    },
    {
      "id": "route",
      "name": "Route by priority",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        660,
        0
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "P1",
              "conditions": {
                "options": {
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "p1",
                    "operator": {
                      "type": "number",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.priority }}",
                    "rightValue": 1
                  }
                ]
              }
            },
            {
              "outputKey": "P2",
              "conditions": {
                "options": {
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "p2",
                    "operator": {
                      "type": "number",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.priority }}",
                    "rightValue": 2
                  }
                ]
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "P3"
        }
      }
    },
    {
      "id": "notify-p1",
      "name": "Notify P1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -180
      ],
      "parameters": {
        "method": "POST",
        "url": "=__URL__:core-api/internal/notify/staff",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ severity: 'P1', mention: true, taskId: $json.taskId, title: $json.title, summary: $json.summary }) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "__CRED__:core-api",
          "name": "__CRED__:core-api"
        }
      }
    },
    {
      "id": "sms-p1",
      "name": "SMS manager",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        -180
      ],
      "parameters": {
        "method": "POST",
        "url": "=__URL__:core-api/internal/notify/sms",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: 'manager', template: 'p1_escalation', taskId: $json.taskId, summary: $json.summary }) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "__CRED__:core-api",
          "name": "__CRED__:core-api"
        }
      }
    },
    {
      "id": "wait15",
      "name": "Wait 15 min",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1320,
        -180
      ],
      "webhookId": "grace-esc-wait",
      "parameters": {
        "amount": 15,
        "unit": "minutes"
      }
    },
    {
      "id": "recheck",
      "name": "Still unacknowledged?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        -180
      ],
      "parameters": {
        "method": "GET",
        "url": "=__URL__:core-api/internal/tasks/{{ $json.taskId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "__CRED__:core-api",
          "name": "__CRED__:core-api"
        }
      }
    },
    {
      "id": "escalate",
      "name": "Escalate to on-call",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1760,
        -180
      ],
      "parameters": {
        "workflowId": "__WF__:wf-18",
        "options": {}
      }
    },
    {
      "id": "notify-p2",
      "name": "Notify P2",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=__URL__:core-api/internal/notify/staff",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ severity: 'P2', mention: false, taskId: $json.taskId, title: $json.title, summary: $json.summary }) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "__CRED__:core-api",
          "name": "__CRED__:core-api"
        }
      }
    },
    {
      "id": "digest",
      "name": "Append to digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        180
      ],
      "parameters": {
        "method": "POST",
        "url": "=__URL__:core-api/internal/digest/append",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ taskId: $json.taskId, title: $json.title, priority: $json.priority }) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "__CRED__:core-api",
          "name": "__CRED__:core-api"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Respond 200",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Respond 200": {
      "main": [
        [
          {
            "node": "Parse event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse event": {
      "main": [
        [
          {
            "node": "Route by priority",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by priority": {
      "main": [
        [
          {
            "node": "Notify P1",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notify P2",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Append to digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SMS manager": {
      "main": [
        [
          {
            "node": "Wait 15 min",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 15 min": {
      "main": [
        [
          {
            "node": "Still unacknowledged?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Still unacknowledged?": {
      "main": [
        [
          {
            "node": "Escalate to on-call",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify P1": {
      "main": [
        [
          {
            "node": "SMS manager",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "errorWorkflow": "__WF__:wf-00"
  }
}
