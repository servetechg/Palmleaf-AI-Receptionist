{
  "name": "Grace \u2014 PalmLeaf [B]",
  "firstMessage": "<injected from prompts/first-message.txt>",
  "firstMessageMode": "assistant-speaks-first",
  "model": {
    "provider": "anthropic",
    "model": "claude-sonnet-5",
    "temperature": 0.6,
    "maxTokens": 150,
    "messages": [
      {
        "role": "system",
        "content": "<injected from prompts/system.md>"
      }
    ],
    "toolIds": []
  },
  "voice": {
    "provider": "11labs",
    "voiceId": "sarah",
    "model": "eleven_flash_v2_5",
    "stability": 0.35,
    "similarityBoost": 0.75,
    "style": 0.2,
    "optimizeStreamingLatency": 3,
    "chunkPlan": {
      "enabled": true,
      "minCharacters": 20
    }
  },
  "transcriber": {
    "provider": "deepgram",
    "model": "nova-3",
    "language": "en-US",
    "smartFormat": true,
    "numerals": true,
    "keywords": [
      "PalmLeaf:2",
      "Vagaro:1",
      "Dundee:2",
      "Buffalo:2",
      "Grove:2",
      "acupuncture:1",
      "cryo:1",
      "Massagebook:1"
    ]
  },
  "startSpeakingPlan": {
    "waitSeconds": 0.3,
    "smartEndpointingPlan": {
      "provider": "livekit",
      "waitFunction": "2000 / (1 + exp(-10 * (x - 0.5)))"
    },
    "transcriptionEndpointingPlan": {
      "onPunctuationSeconds": 0.15,
      "onNoPunctuationSeconds": 1.1,
      "onNumberSeconds": 0.7
    }
  },
  "stopSpeakingPlan": {
    "numWords": 2,
    "voiceSeconds": 0.25,
    "backoffSeconds": 0.8
  },
  "server": {
    "url": "${GRACE_EVENTS_URL}",
    "timeoutSeconds": 10
  },
  "serverMessages": [
    "end-of-call-report",
    "status-update",
    "hang",
    "tool-calls",
    "transfer-destination-request"
  ],
  "maxDurationSeconds": 900,
  "backgroundSpeechDenoisingPlan": {
    "smartDenoisingPlan": {
      "enabled": true
    }
  },
  "endCallPhrases": [
    "goodbye",
    "have a great day"
  ],
  "voicemailDetection": {
    "provider": "vapi"
  },
  "compliancePlan": {
    "hipaaEnabled": false,
    "pciEnabled": false
  },
  "artifactPlan": {
    "recordingEnabled": true,
    "loggingEnabled": true,
    "transcriptPlan": {
      "enabled": true,
      "assistantName": "Grace"
    },
    "structuredOutputIds": []
  },
  "backgroundSound": "office",
  "firstMessageInterruptionsEnabled": true
}
