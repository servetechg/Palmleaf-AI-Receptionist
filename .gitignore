# MCP config — resolves secrets from env vars, but never commit the live file.
# Commit .mcp.json.example instead. Invariant I9.
.mcp.json

# Environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
build/
dist/

# Cached Vapi OpenAPI spec — refetched by validate --refresh
platform/vapi/.vapi-openapi.json

# Generated from .lock.json + VAPI_PUBLIC_KEY at serve time
platform/vapi/web-harness/harness-config.js

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code session state — not project source
.claude/
